# Kernel lockdown: root must not be able to put unsigned code in ring 0.
#
# Merged LAST by scripts/sd-fuse/build-kernel.sh, on every build, after
# nanopi5_linux_defconfig, friendlywrt.config and (on a bench build)
# uart-console.config, so that no other fragment can turn these back on:
# merge_config.sh lets a later fragment win. build-kernel.sh asserts the result
# in .config rather than trusting the merge.
#
# Verified boot ends at the kernel. Without this, root - or anything
# that gets root - could load any module, kexec into a kernel nobody signed, or
# write kernel memory through /dev/mem, and the signed kernel would be replaced
# from inside without U-Boot ever being asked.

# Modules. Every .ko must carry a signature from the key this build generated.
# The key is ephemeral: "make distclean" (build-kernel.sh runs it unless
# SKIP_DISTCLEAN=1) deletes certs/signing_key.pem, kbuild makes a fresh one,
# and build-kernel.sh deletes the private half again once the in-tree and the
# out-of-tree modules are signed. Nobody holds a key that this kernel trusts
# after the build finishes, so nobody can sign a module for it.
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y

# kexec would boot a kernel without involving U-Boot at all. KEXEC_SIG would
# need a second key and its own custody; nothing on this board uses kexec.
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set

# Lockdown, forced at the confidentiality level and started before any other
# LSM. It can be raised at runtime but never lowered, and the command line that
# could raise it lives in the signed DTB. Integrity covers module signatures,
# kexec, /dev/mem, /dev/port, PCI BAR and config-space writes, writable debugfs
# files and BPF writes to user memory. Confidentiality adds /proc/kcore,
# kprobes, tracefs, BPF reads of kernel memory and perf register sampling -
# which matters once rootfs_data is encrypted, because the dm-crypt key will be
# sitting in kernel memory.
#
# Checked against what the NPU and MPP actually use: librknnrt talks to rknpu
# through the DRM render node (CONFIG_ROCKCHIP_RKNPU_DRM_GEM) and ioctls; MPP
# through /dev/mpp_service, /dev/dma_heap/* and /proc/mpp_service. None of that
# is gated by lockdown. The rknpu debugfs files are created 0444
# (drivers/rknpu/rknpu_debugger.c), so "cat /sys/kernel/debug/rknpu/load" still
# works; only writes into them are refused (debugfs_locked_down()).
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y

# Lockdown already refuses these. Not building them at all means a lockdown
# regression does not reopen them. Nothing in the image opens /dev/mem or
# /dev/port.
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_PROC_KCORE is not set

# Debug and test facilities the vendor defconfig builds in. LKDTM exists to
# crash the kernel on request; the tracer and the lock and credential debugging
# are attack surface and cost on a shipped kernel.
# CONFIG_LKDTM is not set
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_CREDENTIALS is not set
